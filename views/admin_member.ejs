<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= member.name %> — <%= group.name %> Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            slate: {
              50: '#f8fafc',
              100: '#f1f5f9',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#1e293b',
              900: '#0f172a',
              950: '#020617',
            },
            primary: {
              50: '#ecfdf5',
              100: '#d1fae5',
              200: '#a7f3d0',
              300: '#6ee7b7',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b',
              950: '#022c22',
            },
            secondary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              200: '#c7d2fe',
              300: '#a5b4fc',
              400: '#818cf8',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              800: '#3730a3',
              900: '#312e81',
              950: '#1e1b4b',
            },
          },
          borderRadius: {
            'xl': '1.25rem',
            '2xl': '1.5rem',
            '3xl': '2rem',
          },
          boxShadow: {
            'primary': '0 10px 15px -3px rgba(16, 185, 129, 0.1), 0 4px 6px -4px rgba(16, 185, 129, 0.1)',
            'secondary': '0 10px 15px -3px rgba(99, 102, 241, 0.1), 0 4px 6px -4px rgba(99, 102, 241, 0.1)',
            'glass': '0 8px 32px 0 rgba(31, 38, 135, 0.07)',
          },
          backdropBlur: {
            'md': '12px',
            'lg': '16px',
          },
          animation: {
            'fade-in': 'fadeIn 0.3s ease-in-out',
            'slide-up': 'slideUp 0.4s ease-out',
            'scale-in': 'scaleIn 0.2s ease-out',
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' },
            },
            slideUp: {
              '0%': { transform: 'translateY(10px)', opacity: '0' },
              '100%': { transform: 'translateY(0)', opacity: '1' },
            },
            scaleIn: {
              '0%': { transform: 'scale(0.95)', opacity: '0' },
              '100%': { transform: 'scale(1)', opacity: '1' },
            },
          },
        },
      },
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-50 min-h-screen">
  <%- include('../components/navigation', { isAdmin: true, user: { name: req.user ? req.user.name : 'Admin' } }) %>

  <!-- Main Content -->
  <main class="pt-20 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Back Navigation -->
    <div class="mb-6">
      <a href="/admin" class="inline-flex items-center gap-2 text-slate-600 hover:text-primary-600 font-medium transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to <%= group.name %>
      </a>
    </div>

    <!-- Member Profile Card -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6 shadow-lg animate-fade-in">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-2xl flex items-center justify-center text-white text-2xl font-bold shadow-lg shadow-secondary-200">
            <%= member.name.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-slate-800 mb-1"><%= member.name %></h1>
            <p class="text-slate-500 mb-1"><%= member.email %></p>
            <p class="text-slate-400 text-sm"><%= member.city %>, <%= member.country %></p>
          </div>
        </div>
        <form method="POST" action="/group/remove-member/<%= member.id %>" onsubmit="return confirm('Remove this member from the group?');">
          <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-5 py-2.5 rounded-xl font-semibold transition-all shadow-lg shadow-red-200 hover:shadow-red-300 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Remove from group
          </button>
        </form>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-md animate-slide-up" style="animation-delay: 0.1s;">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-primary-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-slate-500 text-sm font-medium">Completed</span>
        </div>
        <p class="text-3xl font-bold text-slate-800"><%= totals.done || 0 %></p>
      </div>
      
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-md animate-slide-up" style="animation-delay: 0.2s;">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </div>
          <span class="text-slate-500 text-sm font-medium">Missed</span>
        </div>
        <p class="text-3xl font-bold text-slate-800"><%= totals.missed || 0 %></p>
      </div>
      
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-md animate-slide-up" style="animation-delay: 0.3s;">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="text-slate-500 text-sm font-medium">Pending</span>
        </div>
        <p class="text-3xl font-bold text-slate-800"><%= totals.pending || 0 %></p>
      </div>
      
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-md animate-slide-up" style="animation-delay: 0.4s;">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-secondary-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <span class="text-slate-500 text-sm font-medium">Completion</span>
        </div>
        <p class="text-3xl font-bold text-slate-800"><%= pct === null ? '—' : pct + '%' %></p>
      </div>
    </div>

    <!-- History Table -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-lg animate-slide-up" style="animation-delay: 0.5s;">
      <h2 class="text-xl font-bold text-slate-800 mb-4">Full history</h2>
      <% if (history.length === 0) { %>
        <div class="text-center py-8">
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <p class="text-slate-500">No prayer responses logged yet for this member.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-slate-200">
                <th class="text-left py-3 px-4 text-sm font-semibold text-slate-600">Date</th>
                <th class="text-left py-3 px-4 text-sm font-semibold text-slate-600">Prayer</th>
                <th class="text-left py-3 px-4 text-sm font-semibold text-slate-600">Status</th>
                <th class="text-left py-3 px-4 text-sm font-semibold text-slate-600">Responded at</th>
              </tr>
            </thead>
            <tbody>
              <% history.forEach(function(r) { %>
                <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                  <td class="py-3 px-4 text-sm text-slate-700"><%= r.date %></td>
                  <td class="py-3 px-4 text-sm text-slate-700"><%= r.prayer_name %></td>
                  <td class="py-3 px-4">
                    <% if (r.status === 'done') { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-primary-100 text-primary-700">
                        <span class="mr-1">✓</span> Done
                      </span>
                    <% } else if (r.status === 'missed') { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">
                        <span class="mr-1">✗</span> Missed
                      </span>
                    <% } else if (r.status === 'pending') { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700">
                        <span class="mr-1">○</span> Pending
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-600">
                        <span class="mr-1">○</span> <%= r.status %>
                      </span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-sm text-slate-500"><%= r.responded_at || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
