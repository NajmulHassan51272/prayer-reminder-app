<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin — <%= group.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              300: '#86efac',
              400: '#4ade80',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              800: '#166534',
              900: '#14532d',
            },
            accent: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              200: '#bae6fd',
              300: '#7dd3fc',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            }
          },
        },
      },
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-50 min-h-screen">
  <%- include('components/navigation', { isAdmin: true, user: { name: 'Admin' } }) %>
  <div class="container mx-auto px-4 py-8 max-w-6xl">

    <!-- Admin Header -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6 shadow-md">
      <h1 class="text-2xl font-bold text-slate-800 mb-3"><%= group.name %> — Admin</h1>
      <div class="flex items-center gap-4 flex-wrap">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">
          <%= memberCount %>/30 members
        </span>
      </div>
    </div>

    <!-- Invite Members Section -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6 shadow-md">
      <h2 class="text-xl font-bold text-slate-800 mb-4">Invite Members</h2>
      <div class="flex gap-3">
        <input type="email" id="invite-email" placeholder="Enter email address" 
               class="flex-1 px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all" />
        <button onclick="inviteMember(false)" 
                class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors shadow-lg shadow-emerald-200">
          Send Invite
        </button>
        <button onclick="inviteMember(true)" 
                class="bg-slate-600 hover:bg-slate-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors shadow-lg">
          Resend
        </button>
      </div>
      <div id="invite-message" class="mt-3 text-sm hidden"></div>
    </div>

    <!-- Today's Completion Summary -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6 shadow-lg">
      <h2 class="text-xl font-bold text-slate-800 mb-6">Today's completion (<%= date %>)</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <% prayerSummary.forEach(function(s) { %>
          <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl border border-slate-200 p-5 text-center shadow-sm hover:shadow-md transition-shadow">
            <div class="font-bold text-emerald-700 text-sm mb-2 uppercase tracking-wide"><%= s.name %></div>
            <div class="text-3xl font-bold text-slate-800 mb-2"><%= s.done %>/<%= s.total %></div>
            <div class="text-xs text-slate-500 font-medium">
              completed<% if (s.missed > 0) { %> · <span class="text-red-500"><%= s.missed %> missed</span><% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Members Table -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-lg">
      <h2 class="text-xl font-bold text-slate-800 mb-6">Members</h2>
      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="text-left py-4 px-4 text-sm font-semibold text-slate-600">Member</th>
              <% PRAYERS.forEach(function(p) { %><th class="text-center py-4 px-2 text-sm font-semibold text-slate-600"><%= p %></th><% }); %>
              <th class="text-center py-4 px-4 text-sm font-semibold text-slate-600">All-time %</th>
              <th class="text-right py-4 px-4 text-sm font-semibold text-slate-600">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(row) { %>
              <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                <td class="py-4 px-4">
                  <a href="/admin/member/<%= row.member.id %>" class="font-semibold text-slate-800 hover:text-emerald-600 transition-colors"><%= row.member.name %></a>
                  <br/>
                  <span class="text-sm text-slate-500"><%= row.member.email %></span>
                </td>
                <% PRAYERS.forEach(function(p) { %>
                  <td class="py-4 px-2 text-center">
                    <% var st = row.statusMap[p] || 'none'; %>
                    <% if (st === 'done') { %>
                      <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 hover:bg-emerald-200 transition-colors">
                        <span class="mr-2">✓</span> Done
                      </span>
                    <% } else if (st === 'missed') { %>
                      <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-red-100 text-red-700 hover:bg-red-200 transition-colors">
                        <span class="mr-2">✗</span> Missed
                      </span>
                    <% } else if (st === 'pending') { %>
                      <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-amber-100 text-amber-700 hover:bg-amber-200 transition-colors">
                        <span class="mr-2">○</span> Pending
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-slate-200 text-slate-600 hover:bg-slate-300 transition-colors">
                        <span class="mr-2">○</span> —
                      </span>
                    <% } %>
                  </td>
                <% }); %>
                <td class="py-4 px-4 text-center font-semibold text-slate-700">
                  <%= row.pct === null ? '—' : row.pct + '%' %>
                </td>
                <td class="py-4 px-4 text-right whitespace-nowrap">
                  <a href="/admin/member/<%= row.member.id %>" class="inline-block bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-lg text-xs font-semibold transition-colors mr-2">Inspect</a>
                  <form method="POST" action="/group/remove-member/<%= row.member.id %>" onsubmit="return confirm('Remove this member from the group?');" class="inline">
                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg text-xs font-semibold transition-colors">Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    async function inviteMember(resend = false) {
      const emailInput = document.getElementById('invite-email');
      const messageDiv = document.getElementById('invite-message');
      const email = emailInput.value.trim();
      
      if (!email) {
        showMessage('Please enter an email address', 'error');
        return;
      }
      
      try {
        const response = await fetch('/group/invite', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, resend }),
        });
        
        const data = await response.json();
        
        if (data.success) {
          showMessage(data.message, 'success');
          if (!resend) {
            emailInput.value = '';
          }
        } else {
          showMessage(data.error || 'Failed to send invitation', 'error');
        }
      } catch (error) {
        showMessage('Failed to send invitation. Please try again.', 'error');
      }
    }
    
    function showMessage(message, type) {
      const messageDiv = document.getElementById('invite-message');
      messageDiv.textContent = message;
      messageDiv.className = 'mt-3 text-sm ' + (type === 'success' ? 'text-emerald-600' : 'text-red-600');
      messageDiv.classList.remove('hidden');
      
      setTimeout(() => {
        messageDiv.classList.add('hidden');
      }, 5000);
    }
  </script>
</body>
</html>
