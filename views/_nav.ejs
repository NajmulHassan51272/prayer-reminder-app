<div class="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white px-6 py-4 flex justify-between items-center shadow-lg">
  <a href="/dashboard" class="text-white font-bold text-lg hover:opacity-90 transition-opacity">🕌 Prayer Reminder</a>
  <div class="flex items-center gap-4">
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a href="/admin" class="text-white hover:opacity-90 transition-opacity font-semibold">Admin</a>
    <% } %>
    <form method="POST" action="/logout" class="inline">
      <button type="submit" class="text-white hover:opacity-90 transition-opacity font-semibold bg-transparent border-none cursor-pointer">Log out</button>
    </form>
  </div>
</div>
