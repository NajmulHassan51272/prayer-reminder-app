<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Prayer Reminder — Never miss a Salah</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

  <div class="landing-nav">
    <div class="landing-nav-inner">
      <span class="brand">🕌 Prayer Reminder</span>
      <div class="links">
        <a href="/login" class="btn secondary small">Log in</a>
        <a href="/register" class="btn small">Sign up</a>
      </div>
    </div>
  </div>

  <header class="hero">
    <div class="hero-inner">
      <h1>Pray on time, together.</h1>
      <p class="hero-sub">
        Create or join a small group, and get an email the moment each prayer
        starts — timed to your own city, adjusted automatically every day as
        sunrise and sunset shift.
      </p>
      <div class="hero-actions">
        <a href="/register" class="btn large">Get started — it's free</a>
        <a href="/login" class="btn secondary large">I already have an account</a>
      </div>
    </div>
  </header>

  <main class="container wide">

    <section class="features">
      <div class="feature-card">
        <div class="feature-icon">🌍</div>
        <h3>Works anywhere</h3>
        <p class="muted">Times are calculated for each person's own city — Karachi, Lahore, London, wherever your group is.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔄</div>
        <h3>Always up to date</h3>
        <p class="muted">No manual updates. Times are re-fetched daily, so they naturally follow the shift in sunset and sunrise.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">✉️</div>
        <h3>Gentle reminders</h3>
        <p class="muted">An email when it's time to pray, and a short follow-up afterwards asking if you did.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">👥</div>
        <h3>Small, private groups</h3>
        <p class="muted">Create a group with a permanent join code (up to 30 people), or join one you've been invited to.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Group accountability</h3>
        <p class="muted">Group admins can see who's keeping up with their prayers, encouraging consistency together.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3>Simple & private</h3>
        <p class="muted">Just an email and a city — nothing else needed to get started.</p>
      </div>
    </section>

    <section class="quotes-section">
      <h2 class="center">A reminder about Salah</h2>
      <p class="muted center" style="max-width:560px;margin:0 auto 28px;">
        A few words on prayer from the Qur'an and Hadith.
      </p>
      <div class="quotes-grid">
        <% reminders.forEach(function(r) { %>
          <div class="quote-card">
            <span class="quote-type"><%= r.type %></span>
            <p class="quote-text">&ldquo;<%= r.text %>&rdquo;</p>
            <p class="quote-ref">— <%= r.reference %></p>
          </div>
        <% }); %>
      </div>
      <p class="muted" style="font-size:12px;text-align:center;margin-top:20px;">
        Translations shown here are commonly-cited renderings intended as a gentle reminder,
        not a scholarly reference — please verify exact wording against
        <a href="https://quran.com" target="_blank" rel="noopener">quran.com</a> or
        <a href="https://sunnah.com" target="_blank" rel="noopener">sunnah.com</a>.
      </p>
    </section>

    <section class="cta-band">
      <h2>Ready to keep each other consistent?</h2>
      <a href="/register" class="btn large">Create your account</a>
    </section>

  </main>

  <footer class="footer">
    <p class="muted">🕌 Prayer Reminder — built to help small groups stay consistent in Salah.</p>
  </footer>

</body>
</html>
